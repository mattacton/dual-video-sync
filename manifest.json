{
  "manifest_version": 3,
  "name": "Dual Video Sync",
  "version": "1.0.0",
  "description": "Sync two browser video players (e.g., Amazon Prime + Patreon reactions)",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
